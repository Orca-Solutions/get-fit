{
  "name": "get-fit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/core",
    "apps/web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @get-fit/web",
    "build": "npm run build -w @orca-solutions/get-fit-core && npm run build -w @get-fit/web && npm run build -w @get-fit/server",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p apps/web && tsc -p server",
    "build:exercises": "npm run build:exercises -w @orca-solutions/get-fit-core",
    "sample": "npm run sample -w @orca-solutions/get-fit-core --"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
